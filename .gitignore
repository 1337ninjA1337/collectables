# Local, credential-bearing copies of committed templates. The convention is a
# `.local.` segment in the name — `docs/powerbi/queries.local.m`, or a
# `*.local.pbit` exported from Power BI Desktop with the four session-pooler
# parameters filled in. Every document that tells a reader to paste a real
# connection value points at one of these rather than at the tracked template,
# so the mistake cannot be made instead of being caught afterwards.
# `check-secrets` skips them BECAUSE they are ignored here — see
# `SECRET_SKIP_LOCAL_MARKER` in lib/secret-scan.ts, and the case that asserts
# git really does ignore the pattern and that nothing tracked matches it.
*.local.*

# Typescript
*.tsbuildinfo

# IDE
.idea/
.vscode/
.claude/


# Docs
.docs/

# Build artifacts
android/
ios/

# Supabase local CLI cache (contains project ref, org IDs, pooler URLs)
supabase/.temp/

# Supabase CLI config is generated at runtime by the Supabase Tests workflow
# and must NOT be committed — the live Supabase Branching integration treats a
# committed supabase/config.toml as the source of truth for the preview/
# production projects (it would disable undeclared edge functions/storage and
# clobber dashboard-managed settings on merge). See .github/workflows/supabase-test.yml.
supabase/config.toml

.env.local
