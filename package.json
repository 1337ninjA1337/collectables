{
  "name": "collectables",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck",
    "test": "tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./__tests__/test-globals.ts --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=./scripts/test-failure-reporter.ts --test-reporter-destination=stderr __tests__/*.test.ts",
    "test:only": "tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./__tests__/test-globals.ts --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=./scripts/test-failure-reporter.ts --test-reporter-destination=stderr __tests__/*.test.ts",
    "test:sentry": "tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./__tests__/test-globals.ts --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=./scripts/test-failure-reporter.ts --test-reporter-destination=stderr __tests__/sentry-*.test.ts",
    "build:powerbi": "tsx scripts/build-powerbi-template.ts",
    "lint:hex": "tsx scripts/check-inline-hex.ts",
    "lint:radius": "tsx scripts/check-inline-radius.ts",
    "lint:a11y-jsx": "tsx scripts/check-a11y-jsx.ts",
    "lint:env-inlining": "tsx scripts/check-env-inlining.ts",
    "lint:analytics-imports": "tsx scripts/check-analytics-imports.ts",
    "verify:bundle-inlining": "tsx scripts/verify-bundle-inlining.ts",
    "lint:profile-id-pii": "tsx scripts/check-profile-id-pii.ts",
    "lint:orphan-i18n": "tsx scripts/check-orphan-i18n-keys.ts",
    "lint:problem-phrasing": "tsx scripts/check-problem-phrasing-imports.ts",
    "lint:clarity-mask": "tsx scripts/check-clarity-input-mask.ts",
    "lint:migration-docs": "tsx scripts/check-migration-docs.ts",
    "lint:migration-naming": "tsx scripts/check-supabase-migration-naming.ts",
    "lint:secrets": "tsx scripts/check-secrets.ts",
    "lint:secrets:bundle": "tsx scripts/check-bundle-secrets.ts",
    "lint:bundle-size": "tsx scripts/check-bundle-size.ts",
    "lint:bundle-smoke": "tsx scripts/check-bundle-smoke.ts",
    "lint:peer-dep-free": "tsx --test __tests__/sentry-tests-peer-dep-free.test.ts",
    "lint:appstore": "tsx scripts/check-appstore-config.ts",
    "lint:sentry-version": "tsx scripts/check-sentry-version.ts",
    "lint:baseline-provenance": "tsx scripts/check-privacy-baseline-provenance.ts",
    "lint:expo-install": "tsx scripts/check-expo-install.ts",
    "lint:audit-baseline": "tsx scripts/check-audit-baseline.ts",
    "privacy:generate": "tsx scripts/generate-privacy-manifest.ts",
    "powerbi:schema-doc": "tsx scripts/generate-powerbi-schema-doc.ts",
    "db:find-duplicates": "tsx scripts/find-db-duplicates.ts",
    "powerbi:conn": "tsx scripts/print-powerbi-conn.ts",
    "lint:powerbi-doc": "tsx scripts/generate-powerbi-schema-doc.ts --check",
    "sentry:check": "tsx scripts/sentry-doctor.ts",
    "remeasure-floors": "tsx scripts/remeasure-floors.ts",
    "lint:all": "tsx scripts/lint-all.ts",
    "lint:console-swap": "tsx scripts/check-console-swap.ts",
    "lint:reporter-graph": "tsx scripts/check-reporter-graph.ts",
    "lint:comment-terminators": "tsx scripts/check-comment-terminators.ts",
    "lint:ci": "npm run typecheck && npm run lint:all && npm test",
    "verify:dist": "npm run lint:secrets:bundle && npm run lint:bundle-size && npm run lint:bundle-smoke",
    "verify": "npm run lint:ci && npm run lint:audit-baseline && npm run build && npm run verify:dist",
    "postinstall": "npx expo install --check || true",
    "build": "npx expo export --platform web && tsx scripts/build-spa-fallback.ts",
    "deploy": "cross-env-shell 'set -a && [ -f .env ] && . ./.env; set +a && EXPO_PUBLIC_APP_URL=https://1337ninja1337.github.io/collectables npx expo export --platform web --clear && tsx scripts/build-spa-fallback.ts && touch dist/.nojekyll && echo > dist/.gitignore && npx gh-pages -d dist --dotfiles'"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.5.0",
    "@supabase/auth-js": "^2.101.1",
    "@supabase/realtime-js": "^2.104.1",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-menu": "~7.0.0",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "posthog-js": "^1.372.10",
    "posthog-react-native": "^4.44.4",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
